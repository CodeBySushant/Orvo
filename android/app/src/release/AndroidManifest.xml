<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- FEATURE (app icon): strip the tool-only MAIN/LAUNCHER filter
             from MainActivity in the built APK — the real launcher entries
             are the .LauncherIcon* activity-aliases. -->
        <activity
            android:name=".MainActivity"
            tools:node="merge">
            <intent-filter tools:node="removeAll"/>
        </activity>
    </application>
</manifest>
